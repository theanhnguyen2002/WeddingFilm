# Sao chép thành server/.env (hoặc .env ở thư mục gốc) rồi điền. File .env không được đưa lên git.

# --- Cổng và dữ liệu ---
PORT=3001
# TRUST_PROXY=1            # đặt khi chạy sau nginx
# DATA_DIR=./server/data

# --- Tài khoản quản trị đầu tiên (chỉ dùng lần đầu, sau đó đổi trong trang quản trị) ---
ADMIN_EMAIL=chu@ten-mien-cua-ban.vn
ADMIN_PASSWORD=doi-mat-khau-nay

# --- Email báo khi khách gửi thông tin (Gmail) ---
# Bật xác minh 2 bước cho Gmail, rồi tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
SMTP_USER=ten-ban@gmail.com
SMTP_PASS=mat-khau-ung-dung-16-ky-tu
# Email nhận báo. Bỏ trống thì dùng email ở mục "Liên hệ & mạng xã hội" trong trang quản trị.
# NOTIFY_EMAIL=
# MAIL_FROM="Wedding Film <ten-ban@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Đăng nhập bằng Google ---
# Tạo OAuth Client ID loại "Web application" tại https://console.cloud.google.com/apis/credentials
# Thêm địa chỉ trang quản trị (ví dụ https://admin.ten-mien.vn và http://localhost:5174) vào "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# --- Khác ---
# TOKEN_SECRET=chuoi-bi-mat-dai
